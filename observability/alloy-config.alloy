logging {
	level  = "info"
	format = "logfmt"
}

discovery.docker "system" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "10s"
}

discovery.relabel "system" {
	targets = discovery.docker.system.targets

	// Application access/error logs no longer belong to Loki. Keep only the
	// observability stack and infrastructure dependencies in this pipeline.
	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		regex         = "(alertmanager|alloy|cadvisor|grafana|jaeger|loki|node-exporter|otel-collector|payment-postgres|postgres-exporter|prometheus|rabbitmq|redis|redis-exporter)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "compose_project"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		replacement   = "$1"
		target_label  = "container"
	}
}

loki.source.docker "system" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.system.output
	forward_to = [loki.process.system.receiver]
}

loki.process "system" {
	stage.docker { }

	stage.static_labels {
		values = {
			log_scope = "system",
		}
	}

	forward_to = [loki.write.local.receiver]
}

loki.write "local" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
