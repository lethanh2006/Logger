logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "backend" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "5s"
}

discovery.relabel "backend" {
  targets = discovery.docker.backend.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(gateway|auth|user|canteen|todo)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    replacement   = "$1"
    target_label  = "container"
  }
}

loki.source.docker "backend" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.backend.output
  forward_to = [loki.process.backend.receiver]
}

loki.process "backend" {
  stage.docker {}

  // NestJS thêm prefix trước JSON; Express ghi thẳng JSON. Regex này hỗ trợ cả hai.
  stage.regex {
    expression = `(?P<payload>\{.*\})$`
  }

  stage.json {
    source = "payload"
    expressions = {
      timestamp   = "timestamp",
      logged_svc  = "service",
      event       = "event",
      request_id  = "requestId",
      user_id     = "userId",
      method      = "method",
      path        = "path",
      status_code = "statusCode",
      duration_ms = "durationMs",
    }
  }

  stage.labels {
    values = {
      event = "event",
    }
  }

  // Request/user IDs có cardinality cao nên lưu metadata thay vì Loki label.
  stage.structured_metadata {
    values = {
      requestId  = "request_id",
      userId     = "user_id",
      method     = "method",
      path       = "path",
      statusCode = "status_code",
      durationMs = "duration_ms",
    }
  }

  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }

  stage.output {
    source = "payload"
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
